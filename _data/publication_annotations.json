  "schema_version": 1,
  "topic_definitions": [
    {
      "id": "signal-processing",
      "name": "Signal Processing",
      "description": "Sensing, estimation, localization, array processing, beamforming, and model-based anti-jamming."
    },
    {
      "id": "optimization",
      "name": "Optimization",
      "description": "General numerical optimization, constrained and nonconvex algorithms, tensor optimization, and zeroth-order methods."
    },
    {
      "id": "learning-algorithms",
      "name": "Learning Algorithms",
      "description": "Online and reinforcement learning, imitation learning, neural and probabilistic models, and learning-based decision algorithms."
    },
    {
      "id": "wireless",
      "name": "Wireless Networks",
      "description": "Wireless networks, radio maps, channel prediction, communication systems, and network slicing."
    },
    {
      "id": "agents",
      "name": "Agentic Learning",
      "description": "LLM methods, agent-assisted modeling, and automated algorithm discovery."
    },
    {
      "id": "tracking",
      "name": "Target Tracking",
      "description": "Target tracking and radar resource management, including scheduling, sensor coordination, and trajectory planning."
    }
  ],
